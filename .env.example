# ─────────────────────────────────────────────────────────────
# Método Bispo Analytics — variáveis de ambiente
# Copie para .env.local. SEM as chaves, o app roda com dados mock.
# ─────────────────────────────────────────────────────────────

# Windsor.ai — camada de dados (https://windsor.ai)
WINDSOR_API_KEY=
# Conta/cliente padrão para o vertical slice (opcional)
WINDSOR_ACCOUNT_ID=

# Claude (Anthropic) — motor Bispo IA
ANTHROPIC_API_KEY=
BISPO_IA_MODEL=claude-sonnet-4-6

# PostgreSQL (Prisma) — necessário para login/multiempresa e dados persistidos
DATABASE_URL="postgresql://user:pass@localhost:5432/bispo?schema=public"

# Autenticação — segredo para assinar a sessão JWT (use `openssl rand -hex 32`)
AUTH_SECRET="troque-por-um-segredo-aleatorio-de-32+caracteres"

# Admin criado pelo seed (defina em produção; padrão é o login de demonstração)
ADMIN_EMAIL="voce@suaagencia.com"
ADMIN_PASSWORD="uma-senha-forte"
ADMIN_NAME="Seu Nome"
