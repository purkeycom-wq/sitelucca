// Método Bispo Analytics — modelo de dados multi-tenant.
// O vertical slice roda com dados mock; este schema é a base para F1+.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Multi-tenant ───────────────────────────

model Organization {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  plan         Plan         @default(STARTER)
  logoUrl      String?
  primaryColor String       @default("#52623e")
  whiteLabel   Json?
  createdAt    DateTime     @default(now())
  members      Membership[]
  clients      Client[]
}

model User {
  id        String       @id @default(cuid())
  clerkId   String       @unique
  email     String       @unique
  name      String?
  createdAt DateTime     @default(now())
  members   Membership[]
}

model Membership {
  id    String @id @default(cuid())
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId String
  role  Role   @default(VIEWER)

  @@unique([userId, orgId])
}

// Empresas/contas geridas dentro de uma organização (multiempresa).
model Client {
  id        String       @id @default(cuid())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String
  name      String
  logoUrl   String?
  createdAt DateTime     @default(now())

  connections     Connection[]
  insights        Insight[]
  recommendations Recommendation[]
  scores          ScoreSnapshot[]
  reports         Report[]

  @@index([orgId])
}

// ─────────────────────────── Integrações ───────────────────────────

model Connection {
  id               String           @id @default(cuid())
  client           Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId         String
  provider         String // facebook, google_ads, googleanalytics4, instagram_public...
  windsorAccountId String?
  status           ConnectionStatus @default(PENDING)
  lastSyncAt       DateTime?
  config           Json?
  createdAt        DateTime         @default(now())

  metrics  MetricDaily[]
  social   SocialDaily[]
  contents ContentItem[]
  syncLogs SyncLog[]

  @@index([clientId])
}

// Série temporal normalizada de performance de mídia.
model MetricDaily {
  id           String     @id @default(cuid())
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId String
  date         DateTime   @db.Date
  channel      String

  spend       Float @default(0)
  impressions Int   @default(0)
  reach       Int   @default(0)
  clicks      Int   @default(0)
  ctr         Float @default(0)
  cpc         Float @default(0)
  cpm         Float @default(0)
  leads       Int   @default(0)
  cpl         Float @default(0)
  cpa         Float @default(0)
  conversions Int   @default(0)
  revenue     Float @default(0)
  roas        Float @default(0)
  raw         Json?

  @@unique([connectionId, date, channel])
  @@index([connectionId, date])
}

// Série orgânica social (Instagram / Facebook organic).
model SocialDaily {
  id           String     @id @default(cuid())
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId String
  date         DateTime   @db.Date

  followers       Int   @default(0)
  followersGained Int   @default(0)
  reach           Int   @default(0)
  impressions     Int   @default(0)
  engagement      Int   @default(0)
  engagementRate  Float @default(0)
  shares          Int   @default(0)
  saves           Int   @default(0)
  profileVisits   Int   @default(0)
  profileClicks   Int   @default(0)

  @@unique([connectionId, date])
  @@index([connectionId, date])
}

model ContentItem {
  id           String      @id @default(cuid())
  connection   Connection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId String
  externalId   String
  type         ContentType
  caption      String?
  thumbnailUrl String?
  publishedAt  DateTime

  reach           Int   @default(0)
  impressions     Int   @default(0)
  likes           Int   @default(0)
  comments        Int   @default(0)
  shares          Int   @default(0)
  saves           Int   @default(0)
  retention       Float @default(0)
  followersGained Int   @default(0)

  @@unique([connectionId, externalId])
  @@index([connectionId, publishedAt])
}

// ─────────────────────────── Inteligência ───────────────────────────

model Insight {
  id          String          @id @default(cuid())
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  periodStart DateTime
  periodEnd   DateTime
  severity    InsightSeverity @default(INFO)
  metric      String
  delta       Float?
  what        String // O que aconteceu
  why         String // Por que aconteceu
  impact      String // Qual o impacto
  action      String // O que fazer
  createdAt   DateTime        @default(now())

  @@index([clientId, createdAt])
}

model Recommendation {
  id          String   @id @default(cuid())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  channel     String
  title       String
  body        String
  priority    Int      @default(0)
  impactScore Int      @default(0)
  effort      String   @default("medium")
  status      String   @default("open")
  createdAt   DateTime @default(now())

  @@index([clientId, priority])
}

model ScoreSnapshot {
  id         String      @id @default(cuid())
  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String
  date       DateTime    @db.Date
  content    Int
  growth     Int
  traffic    Int
  conversion Int
  engagement Int
  overall    Int
  status     ScoreStatus
  reasoning  Json

  @@unique([clientId, date])
}

// ─────────────────────────── Relatórios ───────────────────────────

model Report {
  id          String   @id @default(cuid())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  type        String   @default("executive")
  periodStart DateTime
  periodEnd   DateTime
  pdfUrl      String?
  shareToken  String?  @unique
  isPublic    Boolean  @default(false)
  config      Json?
  createdAt   DateTime @default(now())
}

model SyncLog {
  id           String     @id @default(cuid())
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId String
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  status       String     @default("running")
  error        String?
}

// ─────────────────────────── Enums ───────────────────────────

enum Plan {
  STARTER
  PRO
  AGENCY
}

enum Role {
  OWNER
  ADMIN
  ANALYST
  VIEWER
  CLIENT
}

enum ConnectionStatus {
  PENDING
  ACTIVE
  ERROR
  PAUSED
}

enum ContentType {
  REEL
  STORY
  CAROUSEL
  POST
}

enum InsightSeverity {
  INFO
  POSITIVE
  WARNING
  CRITICAL
}

enum ScoreStatus {
  EXCELLENT
  ATTENTION
  CRITICAL
}
